# ─────────────────────────────────────────────────────────────────────────────
# SEC-OPS 2.0 Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before starting Docker Compose
# ─────────────────────────────────────────────────────────────────────────────

# ── General Server Settings ──────────────────────────────────────────────────
APP_ENV=production                                 # development | production | testing
PORT=8000
HOST=0.0.0.0
EXTERNAL_SERVER_IP=127.0.0.1                       # Host IP for WebRTC stream clients
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1

# ── Security & Authentication ────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-a-random-64-char-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_INITIAL_PASSWORD=CHANGE_ME_SECURE_ADMIN_PASSWORD_V8
SECOPS_BIOMETRIC_ENABLED=false

# ── Database Credentials (PostgreSQL 16) ─────────────────────────────────────
POSTGRES_USER=secops_admin
POSTGRES_PASSWORD=secops_secure_pass_2026
POSTGRES_DB=secops_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://secops_admin:secops_secure_pass_2026@db:5432/secops_db
DATABASE_URL_SYNC=postgresql://secops_admin:secops_secure_pass_2026@db:5432/secops_db

# ── Redis Cache & PubSub ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Direct Hardware Turnstile GPIO Driver ────────────────────────────────────
# Modes: AUTO (detect RPi.GPIO or fallback) | HARDWARE (force real GPIO) | EMULATED (mock relay)
TURNSTILE_GPIO_MODE=AUTO
TURNSTILE_RELAY_PIN=17                             # BCM GPIO Pin driving the physical relay coil
TURNSTILE_READBACK_PIN=27                          # BCM GPIO Pin reading microswitch feedback
TURNSTILE_AUTO_UNLOCK_SECONDS=30.0                 # Failsafe auto-unlock timer

# ── External Notification Channels (High/Critical Alarms) ────────────────────
# Slack Incoming Webhook (Leave blank to disable)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Telegram Bot API (Leave blank to disable)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_CHAT_ID=-1001234567890

# Generic / Mobile Push Webhook
MOBILE_PUSH_WEBHOOK_URL=https://push.example.com/api/v1/notify

# ── Camera Fleet & RTSP Defaults ─────────────────────────────────────────────
DEFAULT_STREAM_TIMEOUT_SEC=2.5
MEDIA_STORAGE_PATH=/app/media
SNAPSHOT_RETENTION_DAYS=90

