# =============================================================================
# Git Ignore Configuration for Smart Retail Exit Monitoring System (SEC-OPS V8)
# =============================================================================

# Environment & Secrets (NEVER commit secrets to Git)
.env
.env.*
!.env.example
vercel_env_ready.txt
*.exe


# Python Virtual Environments & Packages
.venv/
venv/
env/
ENV/
*.egg-info/
.installed.cfg
*.egg

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js & Frontend Build Outputs
node_modules/
.next/
out/
build/
dist/
dist-ssr/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.local

# Database Files & SQLite
*.db
*.sqlite
*.sqlite3
retail_secops.db
retail_exit.db

# Uploaded Files & Temporary Surveillance Media
uploads/
snapshots/
retail-exit-backend/uploads/*
!retail-exit-backend/uploads/.gitkeep
retail-exit-backend/uploads/invoices/*
!retail-exit-backend/uploads/invoices/.gitkeep
retail-exit-backend/snapshots/*
!retail-exit-backend/snapshots/.gitkeep
retail-exit-backend/data/*
!retail-exit-backend/data/.gitkeep
retail-exit-backend/data/active_learning/candidates/*
retail-exit-backend/data/active_learning/curated/*
retail-exit-backend/data/dispatch_evidence/*

# Temporary & Scratch Files
*.csv.tmp
*.log
logs/

# System & OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Agent & Tool Runtime Metadata
.agent/
.agents/
.gemini/
.gsd/

# Pytest Cache & Temporary Test Databases
.pytest_cache/
tests/*.db
tests/*.sqlite*
retail-exit-backend/tests/*.db
retail-exit-backend/tests/*.sqlite*
retail-exit-backend/ml/
retail-exit-backend/src/ml/weights/checkpoints/*.onnx
!retail-exit-backend/src/ml/weights/checkpoints/.gitkeep

# Hardware Runtime State, Local Tunnel & Local Dev Scripts
retail-exit-backend/src/hardware/usb_state.json
retail-exit-backend/run_local_backend_and_tunnel.py
retail-exit-backend/scripts/apply_clean_db.py
retail-exit-backend/scripts/init_db.py
retail-exit-backend/scripts/set_owner.py
retail-exit-backend/scripts/view_db.py
retail-exit-backend/scripts/check_*.py
retail-exit-backend/scripts/inspect_*.py
retail-exit-backend/scripts/clean_*.py
retail-exit-backend/scripts/reset_*.py
retail-exit-backend/scripts/bootstrap_*.py
retail-exit-backend/scripts/test_*.py
retail-exit-backend/scripts/verify_*.py
retail-exit-backend/scripts/update_and_apply_*.py
retail-exit-backend/scripts/current_hash.txt
pyrightconfig.json
*.bat

# Exclude non-README markdown files from Git repository
*.md
!README.md
docs/*.md
retail-exit-backend/*.md
!retail-exit-backend/README.md
retail-exit-nextjs/*.md
!retail-exit-nextjs/README.md

