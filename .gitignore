# =============================================================================
# Git Ignore Configuration for Smart Retail Exit Monitoring System (SEC-OPS 2.0)
# =============================================================================

# Python Virtual Environments & Packages
.venv/
venv/
env/
ENV/
*.egg-info/
.installed.cfg
*.egg

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node.js & Frontend Build Outputs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
dist-ssr/
*.local

# Database Files & SQLite
*.db
*.sqlite
*.sqlite3
retail_exit.db

# Uploaded Files & Temporary Surveillance Snapshots
retail-exit-backend/uploads/invoices/*
!retail-exit-backend/uploads/invoices/.gitkeep
retail-exit-backend/snapshots/*
!retail-exit-backend/snapshots/.gitkeep
retail-exit-backend/data/*
!retail-exit-backend/data/.gitkeep

# System & OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Settings
.vscode/*
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project

# Logs
*.log
logs/

