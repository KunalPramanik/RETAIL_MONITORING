# =============================================================================
# Git Ignore Configuration for Smart Retail Exit Monitoring System (SEC-OPS V8)
# =============================================================================

# Environment & Secrets (NEVER commit secrets to Git)
.env
.env.*
!.env.example

# Python Virtual Environments & Packages
.venv/
venv/
env/
ENV/
*.egg-info/
.installed.cfg
*.egg

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js & Frontend Build Outputs
node_modules/
.next/
out/
build/
dist/
dist-ssr/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.local

# Database Files & SQLite
*.db
*.sqlite
*.sqlite3
retail_secops.db
retail_exit.db

# Uploaded Files & Temporary Surveillance Media
uploads/
snapshots/
retail-exit-backend/uploads/*
!retail-exit-backend/uploads/.gitkeep
retail-exit-backend/uploads/invoices/*
!retail-exit-backend/uploads/invoices/.gitkeep
retail-exit-backend/snapshots/*
!retail-exit-backend/snapshots/.gitkeep
retail-exit-backend/data/*
!retail-exit-backend/data/.gitkeep
retail-exit-backend/data/active_learning/candidates/*
retail-exit-backend/data/active_learning/curated/*
retail-exit-backend/data/dispatch_evidence/*

# Temporary & Scratch Files
*.csv.tmp
*.log
logs/

# System & OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Agent & Tool Runtime Metadata
.agent/
.agents/
.gemini/
.gsd/
