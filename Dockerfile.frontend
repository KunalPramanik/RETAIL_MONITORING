# ─────────────────────────────────────────────────────────────────────────────
# SEC-OPS 2.0 Frontend Console Production Dockerfile
# Multi-stage build: Node 20 builder + Nginx Alpine runner
# ─────────────────────────────────────────────────────────────────────────────

FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency definitions
COPY retail-exit-console/package.json retail-exit-console/package-lock.json ./
RUN npm ci

# Copy frontend source files
COPY retail-exit-console/ ./

# Build production bundle
ENV VITE_API_URL=/api
RUN npm run build

# ── Production Nginx Runner ───────────────────────────────────────────────────
FROM nginx:1.25-alpine AS runner

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy built production artifacts from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx reverse proxy configuration
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O - http://localhost/nginx-health || exit 1

CMD ["nginx", "-g", "daemon off;"]

