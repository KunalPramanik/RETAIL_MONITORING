APP_NAME="SEC-OPS Retail Exit Monitoring Platform"
APP_VERSION="2.0.0"
ENVIRONMENT="production"
SECOPS_DEBUG="false"

# Database
DATABASE_URL="postgresql+asyncpg://secops:secops_password@db:5432/secops_retail"

# Security
JWT_SECRET_KEY="your-secure-random-secret-key"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="1440"

# CORS
CORS_ORIGINS="https://dashboard.secops.local,https://admin.secops.local"

# Machine Learning
DEFAULT_STORE_ID="store_001"
DEFAULT_VISION_MODEL="yolov8-retail-pack-v2.1"
DEFAULT_OCR_MODEL="paddleocr-invoice-layout-v3.0"
DEFAULT_FACE_MODEL="arcface-r100-512d-v1.4"

# Message Broker
REDIS_URL="redis://redis:6379/0"
WS_HEARTBEAT_INTERVAL_SEC="15"
