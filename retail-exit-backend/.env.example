# SEC-OPS 2.0 Environment Configuration Template
# Instructions: Copy this file to .env and fill in production-grade credentials.
# Do NOT commit .env to version control.

# Application Metadata
APP_NAME=SEC-OPS Retail Exit Monitoring Platform
APP_VERSION=2.0.0
ENVIRONMENT=production
SECOPS_DEBUG=false

# Database Configuration (PostgreSQL recommended for production)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Note: SQLite :memory: is strictly prohibited in production.
DATABASE_URL=

# Security Credentials
# Mandatory: JWT signing secret (minimum 32 characters; generate with 'openssl rand -hex 32')
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Mobile Device Gateway HMAC Secret (minimum 16 characters; generate with 'openssl rand -hex 32')
MOBILE_HMAC_SECRET=

# CORS Allowed Origins
# Comma-separated list of origins. Wildcard '*' is strictly prohibited when allow_credentials=True.
# Example: https://dashboard.retail.example.com,https://admin.retail.example.com
CORS_ORIGINS=

# Edge Ingestion & ML Defaults
DEFAULT_STORE_ID=
DEFAULT_VISION_MODEL=yolox-retail-pack-v2.1
DEFAULT_OCR_MODEL=paddleocr-invoice-layout-v3.0
DEFAULT_FACE_MODEL=arcface-r100-512d-v1.4

# Message Broker & Real-Time Hub (Optional)
# Format: redis://<host>:<port>/<db>
REDIS_URL=
WS_HEARTBEAT_INTERVAL_SEC=15

